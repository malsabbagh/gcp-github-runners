# VM Instance Lifecycle Management
# This creates a Managed Instance Group with lifecycle hooks for reliable cleanup

# TEMPORARILY DISABLED: Managed Instance Group for GitHub runners with lifecycle hooks
# (SPOT instances with DELETE termination action can't be used in MIGs)
/*
resource "google_compute_region_instance_group_manager" "github_runners" {
  name   = "github-runners-mig"
  region = var.region
  
  base_instance_name = "github-runner"
  target_size        = 0  # Start with 0, scale as needed
  
  version {
    instance_template = google_compute_instance_template.runner_template.id
    name              = "primary"
  }
  
  # Lifecycle management
  instance_lifecycle_policy {
    force_update_on_repair    = "YES"
    default_action_on_failure = "REPAIR"
  }
  
  # Auto healing
  auto_healing_policies {
    health_check      = google_compute_health_check.runner_health.id
    initial_delay_sec = 300
  }
  
  # Update policy
  update_policy {
    type                         = "PROACTIVE"
    instance_redistribution_type = "NONE"
    minimal_action               = "REPLACE"
