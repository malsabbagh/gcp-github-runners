{
  "name": "cleanup-function",
  "version": "1.0.0",
  "description": "Controller-mediated conservative cleanup for one-job Spot runners",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "google-auth-library": "9.15.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "jest-environment-node": "29.7.0"
  },
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "npm run test:coverage --prefix ../..",
    "test:coverage-check": "npm run test:coverage-check --prefix ../.."
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "index.js",
      "retirement-controller.js",
      "!node_modules/**",
      "!coverage/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "transform": {}
  },
  "keywords": [
    "github",
    "cleanup",
    "runner"
  ]
}
