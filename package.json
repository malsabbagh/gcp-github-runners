{
  "name": "gcp-github-runners",
  "version": "1.0.0",
  "description": "GitHub Runner Infrastructure with Cloud Functions",
  "private": true,
  "workspaces": [
    "cloud-functions/webhook-handler",
    "cloud-functions/cleanup-function"
  ],
  "scripts": {
    "test": "npm run test:fixtures && npm run test:webhook-handler && npm run test:cleanup-function && npm run test:python",
    "test:webhook-handler": "npm run test:all --workspace=webhook-handler -- --runInBand",
    "test:cleanup-function": "cd cloud-functions/cleanup-function && npm test",
    "test:coverage": "node scripts/test-coverage.cjs",
    "test:coverage:webhook-handler": "cd cloud-functions/webhook-handler && npm run test:coverage",
    "test:coverage:cleanup-function": "cd cloud-functions/cleanup-function && npm run test:coverage",
    "test:coverage-check": "node scripts/test-coverage.cjs --check",
    "test:coverage-check:webhook-handler": "cd cloud-functions/webhook-handler && npm run test:coverage-check",
    "test:coverage-check:cleanup-function": "cd cloud-functions/cleanup-function && npm run test:coverage-check",
    "start": "functions-framework --target=controllerHttp",
    "test:fixtures": "node --test tests/*.test.js",
    "test:python": "python3 scripts/test-python.py",
    "package:controller": "node packaging/assemble-controller.js",
    "check:archive": "node packaging/check-controller.js"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "jest": "29.7.0",
    "jest-environment-node": "29.7.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.1.7"
  },
  "author": "Mohamad Alsabbagh",
  "license": "MIT",
  "main": "controller-entry.js",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@google-cloud/cloudbuild": "4.8.1",
    "@google-cloud/compute": "4.12.0",
    "@google-cloud/firestore": "7.11.2",
    "@google-cloud/functions-framework": "5.0.5",
    "@google-cloud/secret-manager": "5.6.0",
    "@octokit/auth-app": "6.1.3",
    "@octokit/rest": "20.1.2",
    "google-auth-library": "9.15.1"
  }
}
