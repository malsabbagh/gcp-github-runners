{
  "layout": "Single unified authenticated controller HTTP archive with preserved cloud-functions sibling modules",
  "runtime": "nodejs24",
  "root_main": "controller-entry.js",
  "http_entrypoint": "controllerHttp",
  "factory_export": "createControllerDeployment(options, {runtimeFactory?})",
  "production_factory": "cloud-functions/webhook-handler/deployment-runtime.js:createProductionDeployment",
  "archive_command": "npm run package:controller",
  "archive_path": "dist/controller.zip",
  "manifest": "deployment/archive-manifest.json",
  "verification": "npm run check:archive compares current source/imports/paths/modes/lock with tracked contracts; assembly reopens and verifies the actual ZIP",
  "excluded": [
    ".git",
    "ambient credentials/configuration/state",
    "node_modules",
    "tests",
    "workspace package manifests",
    "legacy index registration",
    "Terraform"
  ],
  "cloud_deployment_performed": false,
  "default_readiness_flags": false,
  "project_notices": [
    "LICENSE",
    "NOTICE.md"
  ],
  "source_map_and_modes": "deployment/archive-source-map.json",
  "local_receipt": "dist/controller-receipt.json",
  "receipt_scope": "Clean revision-bound local packaging only; full source and live qualification remain separate",
  "inventory_regeneration": "node packaging/check-controller.js --write-inventory"
}
